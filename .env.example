# Copy to .env and fill in. Never commit .env.
# PAPER TRADING ONLY. Live keys must not be used in this repo.

ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Must stay false. The app refuses to start if this is true.
ALPACA_LIVE_TRADE=false

# Universe the overlay agent watches (comma-separated).
UNDERLYINGS=SPY

# Risk limits enforced in code, not by the LLM.
MAX_CONTRACTS_PER_ORDER=5
MAX_ORDER_NOTIONAL_USD=2500
MAX_EQUITY_NOTIONAL_USD=80000
SEED_SHARES=100
MAX_DAILY_LOSS_USD=1500
MIN_EQUITY_USD=80000

# Execution safety: keep true until the strategy is trusted.
DRY_RUN=true

# Optional LLM for the agent loop (install with: uv sync --extra llm)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
