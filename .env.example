# Copy to .env and fill in. Never commit .env.
# PAPER TRADING ONLY. Live keys must not be used in this repo.

ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Must stay false. The app refuses to start if this is true.
ALPACA_LIVE_TRADE=false

# Execution safety: keep true until the engine is trusted.
DRY_RUN=true

# --- Universe -----------------------------------------------------------------
# Liquidity is re-checked at runtime, so an illiquid name here simply never trades.
UNIVERSE=SPY,QQQ,IWM,DIA,GLD,TLT,NVDA,TSLA,AMD,AAPL,MSFT,META,AMZN,GOOGL
# Index ETFs move together and therefore share one concentration budget.
BETA_BUCKET=SPY,QQQ,IWM,DIA
HEDGE_SYMBOL=SPY

# --- Expiry window ------------------------------------------------------------
MIN_DTE=1
MAX_DTE=9

# --- Signal thresholds --------------------------------------------------------
VRP_Z_ENTRY=0.15
TERM_SLOPE_BLACKOUT=0.08
TARGET_SHORT_DELTA=0.22
TARGET_CONDOR_DELTA=0.18
DEBIT_LONG_DELTA=0.45
DEBIT_SHORT_DELTA=0.25

# --- Liquidity gates ----------------------------------------------------------
MIN_OPEN_INTEREST=200
MAX_SPREAD_FRACTION=0.08
MAX_EXIT_SPREAD_FRACTION=0.25

# --- Expected-value gates -----------------------------------------------------
MIN_EDGE=0.03
MIN_WEDGE=0.02

# --- Sizing and risk budgets (fractions of equity) ---------------------------
KELLY_FRACTION=0.35
RISK_BUDGET_PCT=0.45
MAX_TRADE_LOSS_PCT=0.045
MAX_UNDERLYING_LOSS_PCT=0.12
MAX_BUCKET_LOSS_PCT=0.30
MAX_STRESS_LOSS_PCT=0.18
MAX_NET_DELTA_PCT=0.25
MAX_CONTRACTS_PER_ORDER=40

# --- Account circuit breakers ------------------------------------------------
START_EQUITY_USD=100000
EQUITY_FLOOR_PCT=0.82
MAX_DAILY_LOSS_PCT=0.06
MAX_DRAWDOWN_PCT=0.18

# --- Trading window (US/Eastern) ---------------------------------------------
OPEN_DELAY_MINUTES=15
NO_NEW_RISK_BEFORE_CLOSE_MINUTES=20
FORCED_EXIT_HOUR_ET=15

# --- Management thresholds ----------------------------------------------------
PROFIT_TAKE_CREDIT_PCT=0.55
PROFIT_TAKE_CONDOR_PCT=0.60
PROFIT_TAKE_DEBIT_PCT=1.00
STOP_LOSS_CREDIT_MULTIPLE=2.0
ASSIGNMENT_DELTA=0.60
ASSIGNMENT_PROXIMITY_PCT=0.005

# --- Legacy book --------------------------------------------------------------
# Lets the engine flatten positions it did not open, freeing their collateral.
ALLOW_LEGACY_UNWIND=true

# --- Research plane (Alpaca MCP server) --------------------------------------
MCP_ENABLED=true
MCP_COMMAND=uvx
MCP_ARGS=alpaca-mcp-server
MCP_TIMEOUT_SECONDS=45

# Optional LLM analyst (install with: uv sync --extra llm)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
